NODE_ENV=local
NODE_PORT=4001

# Database (MySQL)
TYPEORM_HOST=127.0.0.1
TYPEORM_PORT=3306
TYPEORM_USERNAME=root
TYPEORM_PASSWORD=
TYPEORM_DATABASE=express_ts_skeleton

# Auth. Set a long random value before using encrypt/decrypt.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
secret_key=

# Email (optional for local dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
